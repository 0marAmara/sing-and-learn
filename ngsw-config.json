{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {"files": ["/index.html", "/*.css", "/*.js", "/assets/manifest.webmanifest", "/assets/icons/icon-192.png", "/assets/icons/icon-512.png"]}
    },
    {
      "name": "audio",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {"files": [
        "/assets/audio/multiplication-song.mp3",
        "/assets/audio/table-3.mp3",
        "/assets/audio/table-4.mp3",
        "/assets/audio/table-5.mp3",
        "/assets/audio/table-6.mp3",
        "/assets/audio/table-7.mp3",
        "/assets/audio/table-9.mp3",
        "/assets/timings.json"
      ]}
    }
  ]
}
